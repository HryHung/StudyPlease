{
  "manifest_version": 3,
  "name": "StudyPlease",
  "version": "1.0.0",
  "description": "Turn distracting websites into short English vocabulary checkpoints.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "StudyPlease",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
